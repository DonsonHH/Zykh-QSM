QSM_NETWORK_STATUS_PATH=/api/network/status
QSM_NETWORK_START_4G_PATH=/api/network/start_4g
QSM_NETWORK_TIMEOUT_SECONDS=3
QSM_AI_CHAT_PATH=/api/ai/chat
LOCAL_CAMERA_MODE=real
LOCAL_CAMERA_DEVICE=auto
