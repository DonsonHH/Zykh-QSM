# Copy to jetson_app/.env on the QSM main terminal if you want local overrides.
# Do not commit real API keys or patient data.

QSM_HOST=127.0.0.1
QSM_PORT=8088
QSM_DATA_DIR=/home/jetson/Documents/zykh/Zykh-QSM/jetson_app/data
QSM_DB_PATH=/home/jetson/Documents/zykh/Zykh-QSM/jetson_app/data/zykh_qsm.db

QSM_API_BASE=http://127.0.0.1:18080
QSM_ADB_LOCAL_PORT=18080
QSM_ADB_REMOTE_PORT=8080
QSM_ADB_AUTO_FORWARD=1

AI_API_BASE=https://api.deepseek.com/chat/completions
AI_MODEL=deepseek-v4-flash
AI_API_KEY_FILE=/home/jetson/Documents/zykh/Zykh-QSM/jetson_app/data/ai-api-key.txt

# Local / offline AI. The app only connects to these providers; it does not
# install Ollama or download models automatically.
LOCAL_AI_PROVIDER=ollama
LOCAL_AI_BASE_URL=http://127.0.0.1:11434
LOCAL_AI_MODEL=qwen2.5:1.5b
LOCAL_AI_TIMEOUT_SECONDS=10

# Keep true for development and tests. Set false only before a supervised
# hardware demo that is allowed to trigger the dispense mechanism.
DISPENSE_DRY_RUN=true
